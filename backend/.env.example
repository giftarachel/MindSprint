# ============================================================
# MindSprint Backend – Environment Variables
# Copy this file to backend/.env and fill in your values.
# NEVER commit your real .env file to version control.
# ============================================================

# MongoDB
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/
MONGO_DB_NAME=mindsprint

# Flask
SECRET_KEY=replace-with-a-long-random-string-min-32-chars
FLASK_ENV=development

# Frontend origin for CORS (no trailing slash)
FRONTEND_URL=http://localhost:5173
